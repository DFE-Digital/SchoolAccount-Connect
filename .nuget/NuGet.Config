<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add
      key="School Account Package source"
      value="https://dfe-gov-uk.pkgs.visualstudio.com/s268-schoolaccount/_packaging/SchoolAccount/nuget/v3/index.json"
    />
  </packageSources>
  <packageRestore>
    <add key="enabled" value="True" />
  </packageRestore>
  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>
  <packageManagement>
    <add key="format" value="0" />
    <add key="disabled" value="False" />
  </packageManagement>
</configuration>
