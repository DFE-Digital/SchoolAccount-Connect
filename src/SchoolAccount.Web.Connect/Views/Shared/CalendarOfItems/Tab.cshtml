@using SchoolAccount.Kernel
@using SchoolAccount.Kernel.Organisations
@model SchoolAccount.Web.Connect.Models.CalendarOfItems.CalendarOfItemsViewModel
@inject IOrganisationContext OrganisationContext

@if (Model.HasTitle)
{
    <h2 class="govuk-heading-m @(Model.HasDescription || Model.HasLastUpdatedMessage ? "govuk-!-margin-bottom-1" : string.Empty)">@Model.Title</h2>
}
@if (Model.HasDescription)
{
    <p class="govuk-body-m @(Model.HasLastUpdatedMessage ? "govuk-!-margin-bottom-1" : string.Empty)">@Model.Description</p>
}
@if (Model.HasLastUpdatedMessage)
{
    <h3 class="govuk-caption-m">@Model.LastUpdatedMessage</h3>
}

@if (OrganisationContext.Current is TrustOrganisation)
{
    <style>
        .access-org strong.govuk-tag {
            font-size: .75em;
            width: 250px;
            min-width: 250px;
            max-width: 250px;
            border-radius: var(--dfe-border-radius);
            padding: var(--govuk-spacing-responsive--1) var(--govuk-spacing-responsive--2);
        }

        .govuk-task-list__hint.access-org {
            display: flex;
            gap: .5em;
            margin-top: var(--govuk-spacing-responsive--2);
            flex-wrap: wrap;
        }
    </style>
}

<ul class="govuk-task-list">
    @if (Model.Pagination.TotalItemCount > 0 || Model.Items.Count > 0)
    {
        foreach (var group in Model.Items)
        {
            if (group.HasDisplayValue)
            {
                <li class="govuk-task-list__item dfe-task-list__group">
                    <div class="govuk-task-list__name-and-hint">
                        <strong>@group.DisplayValue</strong>
                    </div>
                </li>
            }

            foreach (var row in group)
            {
                <li class="govuk-task-list__item govuk-task-list__item--with-link">
                    <div class="govuk-task-list__name-and-hint">
                        <a class="govuk-link govuk-task-list__link" href="@row.Url">
                            @row.Name
                        </a>
                        <div class="govuk-task-list__hint">
                            @row.Description
                        </div>
                        <div class="govuk-task-list__hint">
                            <strong>@row.DateText</strong>
                        </div>
                        @if (row.HasOrganisation && OrganisationContext.Current is TrustOrganisation trust)
                        {
                            <div class="govuk-task-list__hint access-org">
                                @foreach (var establishment in trust.Establishments)
                                {
                                    <govuk-tag class="govuk-tag--@(row.Organisations.Any(x => x.Id == (int)SchoolAccount.Web.Connect.Authentication.OrganisationContext.DetermineSchoolType(establishment)) ? "green" : "red")">@establishment.Name</govuk-tag>
                                }
                            </div>
                        }
                    </div>
                    @if (row.ShowTag)
                    {
                        <div class="govuk-task-list__status">
                            <govuk-tag class="@row.TagTheme">@row.TagValue</govuk-tag>
                        </div>
                    }
                </li>
            }
        }
    }
    else if (Model.HasNoResultsMessage)
    {
        <li class="govuk-task-list__item">
            <p class="govuk-body">@Model.NoResultsMessage</p>
        </li>
    }
</ul>

<partial name="_Pagination" model="@Model.Pagination"/>

@if (Model.ShowNavigator)
{
    <div class="govuk-body">
        <a class="govuk-link" asp-controller="Calendar" asp-action="Index">@Model.CallToActionMessage</a>
        <partial name="SVG/ArrowRight"/>
    </div>
}