@using SchoolAccount.Web.Connect
@model SchoolAccount.Web.Connect.Models.CalendarOfItems.CalendarOfItemsViewModel

<div class="govuk-grid-row">
    
    <form method="get">
        
        <input type="hidden" asp-for="ViewModes" />
        
        @if (Model.ShowPageHeading)
        {
            <div class="govuk-grid-column-two-thirds">
                @if (Model.HasCaption)
                {
                    <p class="govuk-caption govuk-caption-xl">@Model.Caption</p>
                }
                @if (Model.HasHeading)
                {
                    <h1 class="govuk-heading govuk-heading-xl govuk-!-padding-top-1 govuk-!-margin-bottom-3">@Model.Heading</h1>
                }
                @if (Model.HasSubHeading)
                {
                    <p class="govuk-body-l">@Model.SubHeading</p>
                }
            </div>
        }

        <div class="govuk-grid-column-two-thirds @(Model.IsStandalone ? "govuk-!-margin-top-5" : string.Empty)">
            @if (Model.HasTabs)
            {
                <div class="dfe-tabs">
                    
                    <moj-sub-navigation>
                        @foreach (var tab in Model.Tabs)
                        {
                            <moj-sub-navigation-item href="@tab.Href" current="@tab.IsSelected">@tab.Label</moj-sub-navigation-item>
                        }
                    </moj-sub-navigation>

                    <div class="dfe-tabs__panel">
                        <partial name="@ViewAddressConstraints.CalendarOfItems.Tab" model="@Model"/>
                    </div>

                </div>
            }
            else
            {
                <partial name="@ViewAddressConstraints.CalendarOfItems.Tab" model="@Model"/>
            }
        </div>

    </form>

</div>