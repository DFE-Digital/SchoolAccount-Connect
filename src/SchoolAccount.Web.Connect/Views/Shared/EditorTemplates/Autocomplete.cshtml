@model SchoolAccount.Kernel.IAutocomplete

@{
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName("");
    var fieldHasError = ViewData.ModelState.TryGetValue(name, out var entry) && entry.Errors.Any();
    var errorMessage = fieldHasError ? entry!.Errors.First().ErrorMessage : null;
}

<govuk-input for="@Model" name="@name">
    
    <govuk-input-label is-page-heading="false" class="govuk-label--m">
        @ViewData.ModelMetadata.GetDisplayName()
        @if (!ViewData.ModelMetadata.IsRequired)
        {
            <span class="govuk-hint">(optional)</span>
        }
    </govuk-input-label>
    
    @if (!string.IsNullOrEmpty(ViewData.ModelMetadata.Description))
    {
        <govuk-input-hint>
            @ViewData.ModelMetadata.Description
        </govuk-input-hint>
    }
    
    @if (fieldHasError && !string.IsNullOrEmpty(errorMessage))
    {
        <govuk-input-error-message>
            @errorMessage
        </govuk-input-error-message>
    }

</govuk-input>