@using SchoolAccount.Web.Connect.Extensions
@model long?

@{
    var items = (ViewData["SelectList"] as IEnumerable<SelectListItem>) ?? [];
    
    var field = ViewData.GetFieldMetadata();
}

<govuk-select for="@Model" name="@field.FieldName"> 

    <govuk-select-label is-page-heading="false" class="govuk-label--m">
        @field.Label
        @if (!field.IsRequired)
        {
            <span class="govuk-hint">(optional)</span>
        }
    </govuk-select-label>

    @if (field.HasHint)
    {
        <govuk-select-hint>
            @ViewData.ModelMetadata.Description
        </govuk-select-hint>
    }
    
    @if (field.HasError && !string.IsNullOrEmpty(field.ErrorMessage))
    {
        <govuk-select-error-message>
            @field.ErrorMessage
        </govuk-select-error-message>
    }

    <govuk-select-item>Please select</govuk-select-item>
    @if (items.Any())
    {
        @foreach (var it in items)
        {
            var isSelected = it.Value == Model.ToString();
            <govuk-select-item value="@it.Value" selected="@(isSelected)">
                @it.Text
            </govuk-select-item>
        }
    }
</govuk-select>