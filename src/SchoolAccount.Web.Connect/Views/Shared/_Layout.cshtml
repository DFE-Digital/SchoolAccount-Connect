@using GovUk.Frontend.AspNetCore
@using Microsoft.FeatureManagement
@using SchoolAccount.Application
@using SchoolAccount.Application.Constants
@using SchoolAccount.Kernel.Cookie
@using SchoolAccount.Web.Connect.Extensions
@inject IFeatureManager FeatureManager
@inject ICookieConsentContext CookieConsent

@* ReSharper disable Razor.LayoutNotResolved *@
@* ReSharper disable Razor.SectionNotResolved *@

@{
    Layout = "_GovUkPageTemplate";
    ViewBag.Title = $"{ViewData["Title"]} - {ApplicationConstants.DfeConnect}";

    var feedbackUrl = (string?)ViewData["FeedbackUrl"]
                      ?? "https://digital-forms.education.gov.uk/smxqhd6u2i";

    var isAuthenticated = Context.User.Identity?.IsAuthenticated == true;
}

@section Head {
    @Html.GovUkFrontendStyleImports()
    @Html.MojFrontendStyleImports()
    @Html.DfeFrontendStyleImports()
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
}

@section BodyStart {
    @if (!CookieConsent.IsSet)
    {
        <govuk-cookie-banner aria-label="Cookies on serviceName" id="dfe-cookie-banner">
            <govuk-cookie-banner-message>
                <govuk-cookie-banner-message-heading>
                    Cookies on @ApplicationConstants.DfeConnect
                </govuk-cookie-banner-message-heading>
                <govuk-cookie-banner-message-content>
                    <p class="govuk-body">We use some essential cookies to make this service work.</p>
                    <p class="govuk-body">
                        We’d also like to use analytics cookies so we can understand how you use the
                        service and make improvements.
                    </p>
                </govuk-cookie-banner-message-content>
                <govuk-cookie-banner-message-actions>
                    <govuk-cookie-banner-message-action
                        text="Accept analytics cookies"
                        type="button"
                        id="dfe-cta-acceptCookies"/>
                    <govuk-cookie-banner-message-action
                        text="Reject analytics cookies"
                        type="button"
                        id="dfe-cta-declineCookies"/>
                    <govuk-cookie-banner-message-action-link
                        text="View cookies"
                        href="/cookies"/>
                </govuk-cookie-banner-message-actions>
            </govuk-cookie-banner-message>
        </govuk-cookie-banner>
    }
}

@section Header {
    <partial name="_Header"/>
}

@section BeforeContent {
    <govuk-phase-banner>
        <govuk-phase-banner-tag>Beta</govuk-phase-banner-tag>
        This is a new service. Help us improve it and  
        <a href="@feedbackUrl"
           class="govuk-link"
           target="_blank"
           rel="noopener noreferrer">
            give your feedback (opens in a new tab)
        </a>
    </govuk-phase-banner>

    @await RenderSectionAsync("BeforeContent", false)

    @if (isAuthenticated)
    {
        var showConnectBanner = await FeatureManager.IsEnabledAsync(FeatureFlagConstants.FeedbackBanner);

        if (showConnectBanner)
        {
            <partial
                name="_ConnectBanner"
                view-data='new ViewDataDictionary(ViewData)
                {
                    ["FeedbackUrl"] = feedbackUrl
                }'/>
        }
    }
}

@await RenderSectionAsync("Header", false)

@if (IsSectionDefined("RightSide"))
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @RenderBody()
        </div>
        <div class="govuk-grid-column-one-third">
            @await RenderSectionAsync("RightSide")
        </div>
    </div>
}
else
{
    IgnoreSection("RightSide");
    @RenderBody()
}

@Html.GovUkFrontendScriptImports()
@Html.MojFrontendScriptImports()

<script>
    window.cookieConsentConfig = {
        cookieName: "@CookieConsentConstants.CookieName",
        acceptedValue: "@CookieConsentConstants.IdValues.Accepted",
        rejectedValue: "@CookieConsentConstants.IdValues.Rejected"
    };
</script>

<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/feedback.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

@section Footer {
    @if (isAuthenticated)
    {
        <partial name="_Feedback"/>
    }

    <govuk-footer>
        <govuk-footer-meta>
            <govuk-footer-meta-items>
                <govuk-footer-meta-item href="/privacy">Privacy</govuk-footer-meta-item>
                <govuk-footer-meta-item href="/cookies">Cookies</govuk-footer-meta-item>
                <govuk-footer-meta-item href="/accessibility">Accessibility</govuk-footer-meta-item>
            </govuk-footer-meta-items>
        </govuk-footer-meta>
    </govuk-footer>
}