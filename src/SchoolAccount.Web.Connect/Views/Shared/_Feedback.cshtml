@{
    var feedbackUrl = "https://digital-forms.education.gov.uk/7_RplP8Gef/give-feedback-on-dfe-connect";
    var pageId = Context.Request.Path.ToString().ToLowerInvariant();
}

<section class="dfe-footer-feedback"
         aria-label="Tell us what you think of DfE Connect"
         data-feedback-component="footer"
         data-feedback-post-url="/feedback/page-useful"
         data-feedback-variant="feedback.button">
    <div class="govuk-width-container">
        <div class="dfe-footer-feedback__row">
            <div class="dfe-footer-feedback__left">
                <h2 class="dfe-footer-feedback__heading">
                    Tell us what you think of DfE Connect
                </h2>
            </div>

            <div class="dfe-footer-feedback__right">
                <a class="govuk-button dfe-footer-feedback__button"
                   data-feedback-button
                   data-page-id="@pageId"
                   data-feedback-value="feedback.banner.opened"
                   data-feedback-action="feedback.banner.opened"
                   target="_blank"
                   rel="noopener noreferrer"
                   href="@feedbackUrl">
                    Give your feedback (opens in a new tab)
                </a>
            </div>
        </div>
    </div>
</section>