@model SchoolAccount.Web.Connect.Models.Shared.ListItemViewModel

<li class="govuk-task-list__item govuk-task-list__item--with-link">
    <div class="govuk-task-list__name-and-hint">
        @if (@Model.OpenInNewTab)
        {
        <a class="govuk-link govuk-task-list__link"
           href="@Model.Url"
           target="_blank"
           rel="noopener noreferrer">
            @Model.Name
        </a>
        }
        else
        {
            <a class="govuk-link govuk-task-list__link" href="@Model.Url">
                @Model.Name
            </a>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="govuk-task-list__hint">
                @Model.Description
            </div>
        }
    </div>

    <div class="govuk-task-list__status">
        <partial name="SVG/ChevronRight"/>
    </div>
</li>