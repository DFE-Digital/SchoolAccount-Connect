@using SchoolAccount.Application.Constants
@using SchoolAccount.Web.Connect

@{
    var pageId = ((string?)ViewData["FeedbackPageId"] ?? Context.Request.Path.ToString())
        .Trim('/')
        .Replace("/", "-")
        .ToLowerInvariant();

    if (string.IsNullOrWhiteSpace(pageId))
    {
        pageId = "home";
    }

    var redirectUrl =
        $"{RouteConstants.FeedBackExit}?pageId={Uri.EscapeDataString(pageId)}&ctaType={Uri.EscapeDataString(AnalyticsCtaTypes.Banner)}";

    var cancelUrl =
        $"{RouteConstants.FeedBackCancel}?pageId={Uri.EscapeDataString(pageId)}&ctaType={Uri.EscapeDataString(AnalyticsCtaTypes.Banner)}";

    var bannerDismissed =
        string.Equals(
            Context.Request.Cookies["connect_banner_hidden"],
            "true",
            StringComparison.OrdinalIgnoreCase);
}

@if (!bannerDismissed)
{
    <div class="dfe-connect-banner govuk-!-margin-top-4 govuk-!-margin-bottom-6">
        <h2 class="govuk-heading-m govuk-!-margin-bottom-3">
            Help us improve DfE Connect
        </h2>

        <p class="govuk-body govuk-!-margin-bottom-3">
            To help us improve DfE Connect, we’d like to know more about your visit today.
            <a href="@redirectUrl"
               class="govuk-link"
               target="_blank"
               rel="noopener noreferrer"
               onclick="hideConnectBannerState()">
                Give your feedback (opens in a new tab)
            </a>.
        </p>

        <a href="@cancelUrl"
           class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
            Cancel
        </a>
    </div>
}