@{
    ViewData["Title"] = "Welcome to DfE Connect";
    ViewData["ShowRightHandSide"] = false;
}

<div class="govuk-grid-row">
    <h1 class="govuk-heading-l">
        DfE Connect
    </h1>
</div>

<div class="govuk-grid-row">
    <p class="govuk-body-large">
        You can use DfE Connect to:
    </p>

    <p>
    </p>
    <ul class="govuk-list govuk-list--bullet">
        <li>
            access DfE services and guidance relating to finance and funding
        </li>
        <li>
            manage tasks such as the school census
        </li>
        <li>
            view deadlines, policy updates and best practice guides
        </li>
    </ul>
    <p></p>
    <p class="govuk-body">
        You need a DfE Sign-in account to use this service.
    </p>

    <a href="@Url.Action("Login", "Login")" role="button" draggable="false"
       class="govuk-button govuk-button--start SigninLandingPage" data-module="govuk-button">
        Sign in or register
        <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19"
             viewBox="0 0 33 40" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z"></path>
        </svg>
    </a>

    <h2 class="govuk-heading-l">
        Who can use this service
    </h2>

    <p class="govuk-body">
        DfE Connect is for school business professionals at pre-16 academies, including:
    </p>
    <p>
    </p>
    <ul class="govuk-list govuk-list--bullet">
        <li>
            academy trust professionals
        </li>
        <li>
            chief operating officers
        </li>
        <li>
            finance officers
        </li>
        <li>
            school leaders
        </li>
    </ul>
    <p></p>


</div>


