@model SchoolAccount.Web.Connect.Models.MatAcceptanceViewModel
@{
    ViewData["Title"] = "Trust Notice";
    ViewData["ShowRightHandSide"] = false;
}

<form method="post">
    
    <input type="hidden" asp-for="@Model.LocalReturnAddress" />
    
    <h1 class="govuk-heading">
        You’ve signed in as a trust
    </h1>

    <p class="govuk-body">
        As a trust, you’ll see the same information on DfE Connect as if you’d signed in as a pre-16 academy.
    </p>
    <p class="govuk-heading-l no-margin  para-padding-matView">
        <button type="submit" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
            Continue to pre-16 academy information
        </button>
    </p>

    <h2 class="govuk-heading-m">
        Help us create more for you
    </h2>
    <p class="govuk-body">
        DfE Connect is a new service and we want to add more for you. Research sessions are a chance for you to have a say in how DfE Connect develops for trusts.
    </p>
    <p class="govuk-body">
        If you’d like to help us, email <a class="govuk-link" href="mailto:dfe.connectuserresearch@education.gov.uk" target="_blank42">dfe.connectuserresearch@education.gov.uk</a> so we can arrange a session for you.
    </p>
        
</form>
