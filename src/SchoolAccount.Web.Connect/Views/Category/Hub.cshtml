@using SchoolAccount.Web.Connect
@model SchoolAccount.Web.Connect.Models.Categories.CategoryHubViewModel
@{
    ViewData["Title"] = "Explore categories";
}

@section PageHeading{
    @if (Model.ShowPageHeading)
    {
        @if (Model.HasCaption)
        {
            <p class="govuk-caption govuk-caption-l">@Model.Caption</p>
        }

        @if (Model.HasHeading)
        {
            <h1 class="govuk-heading govuk-heading-l govuk-!-padding-top-0">@Model.Heading</h1>
        }

        @if (Model.HasSubHeading)
        {
            <p class="govuk-body">@Model.SubHeading</p>
        }
    }
}

<partial name="@ViewAddressConstraints.Categories.Hub" model="@Model"/>

@if (Model.IsAcademyTrustHandbook)
{
    @section RightSide{
        <h2 class="govuk-heading-s govuk-!-padding-top-1 govuk-!-margin-bottom-3">
            Academy trust handbook
        </h2>
        
        <a href="@RouteConstants.AcademyTrustHandbook"
           class="govuk-link govuk-link--no-visited-state govuk-body"
           target="_blank"
           rel="noopener noreferrer">
            Academy trust handbook (opens in a new tab)
        </a>
    }
}
