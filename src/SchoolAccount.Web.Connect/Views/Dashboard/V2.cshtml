@using SchoolAccount.Kernel
@model SchoolAccount.Application.Features.Dashboard.Queries.GetDashboard.DashboardLists
@inject IUserContext CurrentUser;

@{
    ViewData["Title"] = "Home";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h2 class="govuk-caption-xl govuk-!-margin-0" style="color: var(--govuk-secondary-text-colour);">Welcome @CurrentUser?.ToString()</h2>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-3">Manage your DfE Connect data</h1>
        <p class="govuk-body-l govuk-!-margin-bottom-8">Manage pages, tasks and resources that will appear on DfE Connect and keep track of requests and teams activity. </p>
    </div>
</div>

<govuk-tabs>
    <govuk-tabs-item id="recently-edited-pages-tab" label="Recently edited Pages">
        <h2 class="govuk-heading-s">
            Recently edited pages
        </h2>
        @foreach (var entry in Model.PageEdits)
        {
            <partial name="_BaseListItem" model="entry"/>
        }
    </govuk-tabs-item>

    <govuk-tabs-item id="recently-published-tab" label="Recently published pages">
        <h2 class="govuk-heading-s">
            Recently published pages
        </h2>

        @foreach (var entry in Model.PagePublished)
        {
            <partial name="_BaseListItem" model="entry"/>
        }
    </govuk-tabs-item>
</govuk-tabs>
