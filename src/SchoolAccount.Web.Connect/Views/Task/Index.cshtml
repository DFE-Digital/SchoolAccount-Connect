@model SchoolAccount.Application.Features.Tasks.GetById.GetTaskByIdResponse

@{
    ViewData["Title"] = "Task details";
}

@section PageHeading
{
    <p class="govuk-caption-l">
        Task
    </p>
    <h1 class="govuk-heading-l govuk-!-padding-top-0">
        @Model.Name
    </h1>
    <p class="govuk-body">
        Track the jobs you need to do to manage your @Model.Name.ToLower() and view information and resources
        that can help you. All links open in a new tab.
    </p>
}

<div class="govuk-tabs">
    <partial name="_Tabs" model="@Model" />
            
    @if (!Model.CurrentSubTasks.Any())
    {   
        <hr class="govuk-section-break govuk-section-break--visible">
        <p>@Model.NoTasksFoundMessage</p>
    }
    else
    {
        <ul class="govuk-task-list">
            @foreach (var subTask in Model.CurrentSubTasks)
            {
                <partial name="_Subtasks" model="subTask" />
            }
        </ul>
    }
</div>

@section RightSide
{
    <partial name="_Guidance" model="@Model" />
}
