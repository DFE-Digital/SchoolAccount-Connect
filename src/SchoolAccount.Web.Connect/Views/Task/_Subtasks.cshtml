@model SchoolAccount.Application.Features.Tasks.GetById.GetTaskByIdResponseSubTask

@{
    ViewData["Title"] = "Task";
}

<li class="govuk-task-list__item @(Model.HasLink ? "govuk-task-list__item--with-link" : "")">
    <div class="govuk-task-list__name-and-hint">
            @if (Model.HasResourceLink)
            {
                <a class="govuk-link govuk-task-list__link" href="@Model.ResourceLink">
                    @Model.Name
                    @if (Model.IsOptional)
                    {
                        <text> (optional)</text>
                    }
                </a>
            }
            else
            {
                <span>
                    @Model.Name
                    @if (Model.IsOptional)
                    {
                        <text> (optional)</text>
                    }
                </span>
            }

            @if (Model.HasDescription)
            {
                <div class="govuk-task-list__hint">
                    @Model.Description
                </div>
            }

            @if (Model.HasAvailabilityLabel || Model.HasDueDateLabel)
            {
                <div class="govuk-task-list__hint">
                    @if (Model.HasAvailabilityLabel)
                    {
                        <text>@Model.AvailabilityLabel</text>
                    }
                    
                    @if (Model.HasDueDateLabel)
                    {
                        <text><strong>@Model.DueDateLabel</strong></text>
                    }
                </div>
            }
    </div>
</li>