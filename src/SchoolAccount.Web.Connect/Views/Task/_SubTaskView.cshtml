@using SchoolAccount.Domain.ViewModels
@model SubTaskViewModel

@{
    ViewData["Title"] = "Home";
}

@if (!@Model.HasLinks)
{    
    <p> 
        @Model.Name
        @if (@Model.IsOptional)
        {
            <text> (optional)</text>
        }
    </p>
}
else
{
    <a class="govuk-link govuk-task-list__link" href="@Model.DigitalLink">
        @Model.Name
        @if (@Model.IsOptional)
        {
            <text> (optional)</text>
        }
    </a>
}
@if (@Model.HasDescription)
{
    <p>@Model.Description</p>
}

<p>@Model.AvailabilityLabel <strong>@Model.DueDateLabel</strong></p>

