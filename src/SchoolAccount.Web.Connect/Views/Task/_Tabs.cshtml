@using SchoolAccount.Application.Features.Tasks.GetById
@model SchoolAccount.Application.Features.Tasks.GetById.TaskResponse

<moj-sub-navigation>
    <moj-sub-navigation-item
        href="@Url.Action("Index", "Task", new { ViewMode = TaskViewMode.UpcomingTasks })"
        current="@Model.IsUpcomingTasksView">
        Upcoming Tasks
    </moj-sub-navigation-item>
    <moj-sub-navigation-item
        href="@Url.Action("Index", "Task", new { ViewMode = TaskViewMode.PreviousTasks })"
        current="@Model.IsPreviousTasksView">
        Previous 12 Months
    </moj-sub-navigation-item>
</moj-sub-navigation>

<div class="govuk-grid-row govuk-!-padding-top-2">
    <div class="govuk-grid-column-full">
        <h2 class="govuk-heading-m">@Model.HeadingText</h2>
        @if (Model.SubTaskLastUpdated.HasValue)
        {
            <h3 class="govuk-caption-m">Last updated: @Model.SubTaskLastUpdated</h3>
        }
    </div>
</div>