@using SchoolAccount.Application.Extensions
@using SchoolAccount.Web.Connect.Models.Tasks
@model SchoolAccount.Web.Connect.Models.Tasks.TaskViewModel

<moj-sub-navigation>
    <moj-sub-navigation-item
        href="@Url.Action("Index", "Task", new { ViewMode = TaskViewMode.UpcomingTasks })"
        current="@Model.IsUpcomingTasksView">
        Upcoming Tasks
    </moj-sub-navigation-item>
    <moj-sub-navigation-item
        href="@Url.Action("Index", "Task", new { ViewMode = TaskViewMode.PreviousTasks })"
        current="@Model.IsPreviousTasksView">
        Previous 12 Months
    </moj-sub-navigation-item>
</moj-sub-navigation>

<h2 class="govuk-heading-m">@Model.HeadingText</h2>
@if (Model.Task.SubTaskLastUpdated.HasValue)
{
    <h3 class="govuk-caption-m">Last updated: @Model.Task.SubTaskLastUpdated.ToGdsDateString()</h3>
}