@{
    ViewData["Title"] = "Support";
}

<div class="govuk-grid-row" id="support-section">
    <div class="govuk-grid-column-full">

        <h1 class="govuk-heading-l">
            Support
        </h1>
        <p class="govuk-body">Resources and guidance that can help guide your decisions or provide support with your
            mandatory tasks.</p>

        <h2 class="govuk-heading-m">
            Networks
        </h2>
        <p class="govuk-body">
            Networks help professionals connect and share information with each other. There are many school business
            professional networks that provide support on work activities, including finance and buying for schools.
        </p>
        <p class="govuk-body">
            <a class="govuk-link"
               href="https://www.gov.uk/government/publications/join-or-create-a-network-for-school-business-professionals"
               target="_blank">Find, join or create a network</a>
        </p>
    </div>
</div>

<div class="govuk-grid-row" id="data-and-insights-section">
    <div class="govuk-grid-column-full">
        <h2 class="govuk-heading-m">
            Data and insights
        </h2>
        <p class="govuk-body">Get data and insights that can help you with finance plans and decisions.</p>
        <p class="govuk-body">All links to data and insight services open in new tabs.</p>

        <div class="dfe-grid-container dfe-grid-container--wider govuk-!-margin-top-5">
            <dfe-card title="Access the Financial Benchmarking and Insights Tool"
                      link="https://financial-benchmarking-and-insights-tool.education.gov.uk"
                      description="Compare your school or trust’s income and expenses with other schools in England.">
                
            </dfe-card>
            
            <dfe-card title="Compare financial management systems"
                      link="https://www.gov.uk/government/publications/choosing-a-trusts-financial-management-system-fms/guide-to-the-fms-comparison-matrix"
                      description="Use DfE’s financial management system (FMS) comparison matrix to choose the best FMS for you.">
                
            </dfe-card>
            
            <dfe-card title="View your education data"
                      link="https://viewyourdata.education.gov.uk/"
                      description="Financial insights for your school as part of the education data service.">
            </dfe-card>
        </div>

        <!-- Guidance and regulations -->
        <h2 class="govuk-heading-m">
            Statutory guidance
        </h2>
        <p class="govuk-body">Read about statutory guidance to find out what you must do to comply with the law.</p>
        <p class="govuk-body">All links to statutory guidance open in new tabs.</p>

        <div class="dfe-grid-container dfe-grid-container--wider govuk-!-margin-top-5">
            <dfe-card title="Academy Trust Handbook"
                      link="https://www.gov.uk/guidance/academy-trust-handbook"
                      description="An overarching framework academy trusts must comply with as a condition of their funding agreement."
                      ></dfe-card>
            
            <dfe-card title="Keeping children safe in education"
                      link="https://www.gov.uk/government/publications/keeping-children-safe-in-education--2"
                      description="Statutory guidance for schools on safeguarding children and safer recruitment.">
            </dfe-card>
            
            <dfe-card title="Public procurement policy"
                      link="https://www.gov.uk/guidance/public-sector-procurement-policy"
                      description="Directives, regulations, policies and guidance relating to the procurement of supplies, services and works for the public sector.">
            </dfe-card>
            
            <dfe-card title="School admissions code"
                      link="https://www.gov.uk/government/publications/school-admissions-code--2"
                      description="Statutory guidance schools must follow when carrying out duties relating to admissions.">
            </dfe-card>
            
            <dfe-card title="SEND code of practice"
                      link="https://www.gov.uk/government/publications/send-code-of-practice-0-to-25"
                      description="Guidance on the special educational needs and disability (SEND) system for children and young people.">
            </dfe-card>
        </div>

        <h2 class="govuk-heading-m">
            Advice and support
        </h2>
        <p class="govuk-body">Read advice and support that could help with the work you do as a school leader, academy
            trust professional or school business manager. </p>
        <p class="govuk-body">All links to advice and support open in new tabs. </p>

        <div class="dfe-grid-container dfe-grid-container--wider govuk-!-margin-top-5">
            <dfe-card title="Buying for schools"
                      link="https://www.gov.uk/guidance/get-help-buying-for-schools"
                      description="Get impartial help and advice from procurement specialists.">
            </dfe-card>
            
            <dfe-card title="DfE help centre"
                      link="https://customerhelp.education.gov.uk/hc/en-gb/categories/360002506639-Articles"
                      description="Help for using DfE and ESFA services.">
            </dfe-card>
            
            <dfe-card title="Financial good practice guides for trusts"
                      link="https://www.gov.uk/government/publications/academy-trust-financial-management-good-practice-guides"
                      description="Good practice guidance for academy trust financial management and assurance.">
            </dfe-card>
            
            <dfe-card title="Funding allocation"
                      link="https://www.gov.uk/government/publications/estimating-your-academy-funding-allocation"
                      description="A guide for schools opening as academies to estimate their revenue funding.">
            </dfe-card>
            
            <dfe-card title="Integrated curriculum and financial planning (ICFP)"
                      link="https://www.gov.uk/guidance/integrated-curriculum-and-financial-planning-icfp"
                      description="Guidance on how you can use ICFP to create the best curriculum for pupils with available funding.">
            </dfe-card>
            
            <dfe-card title="Risk protection arrangement"
                      link="https://www.gov.uk/guidance/the-risk-protection-arrangement-rpa-for-schools"
                      description="The risk protection arrangement (RPA) is an alternative to commercial insurance. Joining might save you time and money.">
            </dfe-card>
            
            <dfe-card title="School resource management advisers"
                      link="https://www.gov.uk/government/publications/the-school-resource-management-advisers-srma-programme"
                      description="A school resource management adviser can help you manage school finances and resources.">
            </dfe-card>
        </div>

    </div>

</div>