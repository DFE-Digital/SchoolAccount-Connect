@model SchoolAccount.Web.Connect.Models.Shared.BasicPageViewModel

@{
    ViewData["Title"] = "Maintenance";
}

@section PageHeading{
    @if (Model.HasOrganisationName)
    {
        <p class="govuk-caption govuk-caption-l">@Model.OrganisationName</p>
    }
    <h1 class="govuk-heading-l govuk-!-padding-top-0">
        Maintenance
    </h1>
    <p class="govuk-body">
        DfE Connect is currently unavailable for maintenance. The service should be available again shortly.
    </p>
}

<p class="govuk-body">
    Any concerns or updates please contact us at
    <a class="govuk-link" href="mailto:dfeconnect@education.gov.uk"
       target="_blank42">dfeconnect@education.gov.uk</a> .
</p>
