@model IReadOnlyCollection<SchoolAccount.Application.Features.Tasks.GetById.GetTaskByIdResponseRelatedTask>

<h2 class="govuk-heading-s govuk-!-padding-top-1 govuk-!-margin-bottom-3">
    Related tasks
</h2>
<ul class="govuk-list">
    @foreach (var relatedTask in Model)
    {
        var relatedTaskUrl = Url.Action("GetById", "GetTaskById", new { id = relatedTask.Id });

        <li>
            <a class="govuk-link govuk-link--no-visited-state" href="@relatedTaskUrl">
                @relatedTask.Name
            </a>
        </li>
    }
</ul>