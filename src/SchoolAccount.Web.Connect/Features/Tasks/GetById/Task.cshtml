@model SchoolAccount.Web.Connect.Features.Tasks.GetById.GetTaskByIdViewModel

@{
    ViewData["Title"] = "Task details";
}

@section PageHeading
{
    <h1 class="govuk-heading-l govuk-!-padding-top-0">
        @Model.Task.Name
    </h1>
    <p class="govuk-body">
        Track the jobs you need to do to manage your @Model.Task.Name.ToLower() and view information and resources
        that can help you.
    </p>
}

<div class="govuk-tabs">
    <partial name="_Tabs" model="@Model"/>

    @if (!Model.SubTasks.Any())
    {
        <hr class="govuk-section-break govuk-section-break--visible">
        <p>@Model.NoTasksFoundMessage</p>
    }
    else
    {
        <ul class="govuk-task-list">
            @foreach (var subTask in Model.SubTasks)
            {
                <partial name="_Subtasks" model="subTask"/>
            }
        </ul>
    }
</div>

@section RightSide
{
    @if (Model.HasResources)
    {
        <partial name="_Guidance" model="Model.ResourcesWithALink"/>
    }

    @if (Model.HasRelatedTasks)
    {
        <partial name="_RelatedTasks" model="Model.Task.RelatedTasks"/>
    }
}