@using SchoolAccount.Application.Features.CalendarOfItems.Common.Enums
@using SchoolAccount.Web.Connect.Features.CalendarOfItems
@model SchoolAccount.Web.Connect.Models.CalendarOfItems.CalendarOfItemsViewModel
@{
    var viewModel = Model.ViewModes.HasFlag(CalendarOfItemsViewModes.Kanban)
    ? CalendarOfItemsConstants.Views.Kanban
    : CalendarOfItemsConstants.Views.Tab;
}
<form method="get">

    <input type="hidden" asp-for="ViewModes"/>
    @if (Model.HasTabs)
    {
        <div class="dfe-tabs" aria-label="Calendar of items view navigation">
            @if (Model.HasSelectedTab)
            {
                <span aria-live="polite" aria-atomic="true" class="govuk-visually-hidden">
                    @Model.CurrentlyActiveTabAccessibilityLabel
                </span>
            }
            <ul class="govuk-tabs__list">
                @foreach (var tab in Model.Tabs)
                {
                    <li class="govuk-tabs__list-item @(tab.IsSelected ? "govuk-tabs__list-item--selected" : string.Empty)">
                        <a class="govuk-tabs__tab" href="@tab.Href">
                            @tab.Label
                        </a>
                    </li>
                }
            </ul>
            
            <div class="dfe-tabs__panel">
                <partial name="@viewModel" model="@Model"/>
            </div>

        </div>
    }
    else
    {
        <partial name="@viewModel" model="@Model"/>
    }
</form>
