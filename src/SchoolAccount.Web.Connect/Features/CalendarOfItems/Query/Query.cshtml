@using SchoolAccount.Application.Features.CalendarOfItems.Common.Enums
@using SchoolAccount.Web.Connect.Features.CalendarOfItems
@model SchoolAccount.Web.Connect.Models.CalendarOfItems.CalendarOfItemsViewModel
@{
    ViewData["Title"] = Model.Heading;
    var wrapperClass = string.Empty;
    var isKanban = Model.ViewModes.HasFlag(CalendarOfItemsViewModes.Kanban);
    ViewData["RenderFullPage"] = isKanban;
}

@if (isKanban)
{
    wrapperClass += "calendar-of-items-wrapper--kanban";
}

@section PageHeading{
    @if (Model.ShowPageHeading)
    {
        @if (Model.HasCaption)
        {
            <p class="govuk-caption govuk-caption-l">@Model.Caption</p>
        }

        @if (Model.HasHeading)
        {
            <h1 class="govuk-heading govuk-heading-l govuk-!-padding-top-0">@Model.Heading</h1>
        }

        @if (Model.HasSubHeading)
        {
            <p class="govuk-body">@Model.SubHeading</p>
        }
    }
}

<div class="calendar-of-items-main @wrapperClass">
    <partial name="@CalendarOfItemsConstants.Views.Widget" model="@Model"/>
</div>

@if (!isKanban)
{
    @section RightSide{
        @if (Model.HasFilters)
        {
            <partial name="_Filtration" model="Model.Filters"/>
        }
    }
}
