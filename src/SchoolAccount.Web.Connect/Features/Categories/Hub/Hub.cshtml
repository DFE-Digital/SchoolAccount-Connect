@using SchoolAccount.Web.Connect
@using SchoolAccount.Web.Connect.Features.Categories
@model SchoolAccount.Web.Connect.Features.Categories.Hub.CategoryHubViewModel
@{
    ViewData["Title"] = "Explore categories";
}

@section PageHeading{
    <h1 class="govuk-heading govuk-heading-l govuk-!-padding-top-0">@Model.Category.DisplayName</h1>

    <p class="govuk-body">@Model.Category.HubViewDescription</p>
}

<partial name="@ViewAddressConstants.Partials.TaskList" model="@Model"/>

@if (Model.IsAcademyTrustHandbookCategory)
{
    @section RightSide{
        <h2 class="govuk-heading-s govuk-!-padding-top-1 govuk-!-margin-bottom-3">
            Academy trust handbook
        </h2>

        <a href="@RouteConstants.AcademyTrustHandbook"
           class="govuk-link govuk-link--no-visited-state govuk-body">
            Academy trust handbook
        </a>
    }
}
