@model SchoolAccount.Web.Connect.Features.Error.ErrorViewModel
@{
    ViewData["Title"] = "Service Inaccessible";
    ViewData["ShowRightHandSide"] = false;
}

<div class="govuk-width-container">
    
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-heading-l">
                Sorry, you cannot currently use this service
            </h1>
            <p>You cannot use this service as it&#x2019;s currently only available to pre-16 academies.</p>
            <p>We're working to expand this service to all academies and maintained schools in future.</p>
            <p><a href="@Model.SignOutUrl" class="govuk-link">Sign out and return to DfE Connect start page</a></p>
        </div>
    </div>

</div>