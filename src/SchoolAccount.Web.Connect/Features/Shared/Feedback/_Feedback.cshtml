@using SchoolAccount.Application.Constants
@using SchoolAccount.Web.Connect

@{
    const string feedbackSubmittedCookieName = "page_feedback_submitted";

    var pageId = ((string?)ViewData["FeedbackPageId"] ?? Context.Request.Path.ToString())
        .ToLowerInvariant();

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var feedbackSubmitted =
        string.Equals(
            Context.Request.Cookies[feedbackSubmittedCookieName],
            "true",
            StringComparison.OrdinalIgnoreCase);

    var redirectUrl =
        $"{RouteConstants.FeedBackExit}?pageId={Uri.EscapeDataString(pageId)}&returnUrl={Uri.EscapeDataString(returnUrl)}&ctaType={Uri.EscapeDataString(AnalyticsCtaTypes.YesNo)}";

    var cancelUrl =
        $"{RouteConstants.FeedBackCancel}?pageId={Uri.EscapeDataString(pageId)}&returnUrl={Uri.EscapeDataString(returnUrl)}&ctaType={Uri.EscapeDataString(AnalyticsCtaTypes.YesNo)}";
}

<section id="page-feedback"
         class="dfe-page-feedback"
         aria-label="Page feedback">
    <div class="govuk-width-container">

        @if (!feedbackSubmitted)
        {
            <div class="dfe-page-feedback__initial">
                <div class="dfe-page-feedback__row">
                    <div class="dfe-page-feedback__left">

                        <span class="dfe-page-feedback__question">
                            Is this page useful?
                        </span>

                        <form method="post"
                              action="@RouteConstants.FeedBackRespond"
                              class="dfe-page-feedback__choices">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="pageId" value="@pageId" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <input type="hidden" name="ctaType" value="@AnalyticsCtaTypes.YesNo" />

                            <button type="submit"
                                    name="selectedAnswer"
                                    value="@AnalyticsAnswers.Yes"
                                    class="dfe-page-feedback__choice">
                                Yes
                            </button>

                            <button type="submit"
                                    name="selectedAnswer"
                                    value="@AnalyticsAnswers.No"
                                    class="dfe-page-feedback__choice">
                                No
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="dfe-page-feedback__followup">
                <div class="dfe-page-feedback__followup-panel">

                    <h2 class="dfe-page-feedback__followup-heading">
                        Help us improve DfE Connect
                    </h2>

                    <p class="dfe-page-feedback__followup-body">
                        To help us improve DfE Connect, we'd like to know more about your visit today.

                        <a class="govuk-link"
                           target="_blank"
                           rel="noopener noreferrer"
                           href="@redirectUrl">
                            Give your feedback (opens in a new tab)
                        </a>.
                    </p>

                    <a href="@cancelUrl"
                       class="govuk-button govuk-button--secondary">
                        Cancel
                    </a>

                </div>
            </div>
        }

    </div>
</section>