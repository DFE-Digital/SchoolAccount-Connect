@using Azure.Core
@using GovUk.Frontend.AspNetCore
@using Microsoft.FeatureManagement
@using SchoolAccount.Application
@using SchoolAccount.Application.Constants
@using SchoolAccount.Kernel
@using SchoolAccount.Kernel.Cookie
@using SchoolAccount.Web.Connect
@using SchoolAccount.Web.Connect.Extensions
@using SchoolAccount.Web.Connect.Features.Cookies
@using SchoolAccount.Web.Connect.Features.Shared.Breadcrumb
@inject IFeatureManager FeatureManager
@inject ICookieConsentContext CookieConsent
@inject IOrganisationContext OrganisationContext

@* ReSharper disable Razor.LayoutNotResolved *@
@* ReSharper disable Razor.SectionNotResolved *@

@{
    Layout = "_GovUkPageTemplate";
    ViewBag.Title = $"{ViewData["Title"]} - {ApplicationConstants.DfeConnect}";

    var feedbackUrl = (string?)ViewData["FeedbackUrl"]
                      ?? "https://digital-forms.education.gov.uk/smxqhd6u2i";

    var isAuthenticated = Context.User.Identity?.IsAuthenticated == true;
    var showRightHandSide = ViewData["ShowRightHandSide"] as bool? ?? true;
    var organisationName = OrganisationContext?.Organisation.Name;
}

@section Head 
{
    @Html.GovUkFrontendStyleImports()
    @Html.MojFrontendStyleImports()
    @Html.DfeFrontendStyleImports()
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
}

@section BodyStart 
{
    @if (!CookieConsent.IsSet)
    {
        using (Html.BeginForm("SetConsent", "Cookies", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="@nameof(CookieConsentRequest.ReturnUrl)" value="@Context.Request.Path" />
            
            <govuk-cookie-banner aria-label="Cookies on serviceName" id="dfe-cookie-banner">
                <govuk-cookie-banner-message>
                    <govuk-cookie-banner-message-heading>
                        Cookies on @ApplicationConstants.DfeConnect
                    </govuk-cookie-banner-message-heading>
                    <govuk-cookie-banner-message-content>
                        <p class="govuk-body">We use some essential cookies to make this service work.</p>
                        <p class="govuk-body">
                            We’d also like to use analytics cookies so we can understand how you use the
                            service and make improvements.
                        </p>
                    </govuk-cookie-banner-message-content>
                    <govuk-cookie-banner-message-actions>
                        <govuk-cookie-banner-message-action
                            text="Accept analytics cookies"
                            type="submit"
                            name="@nameof(CookieConsentRequest.Value)"
                            value="@CookieConsentConstants.IdValues.Accepted" />
                        <govuk-cookie-banner-message-action
                            text="Reject analytics cookies"
                            type="submit"
                            name="@nameof(CookieConsentRequest.Value)"
                            value="@CookieConsentConstants.IdValues.Rejected" />
                        <govuk-cookie-banner-message-action-link
                            text="View cookies"
                            href="@RouteConstants.Cookies" />
                    </govuk-cookie-banner-message-actions>
                </govuk-cookie-banner-message>
            </govuk-cookie-banner>
        }
    }
}

@section GovUkHeader 
{
    <partial name="_Header"/>
}

@section BeforeContent 
{
    <govuk-phase-banner>
        <govuk-phase-banner-tag>Beta</govuk-phase-banner-tag>
        This is a new service. Help us improve it and
        <a href="@feedbackUrl"
           class="govuk-link"
           target="_blank"
           rel="noopener noreferrer">
            give your feedback (opens in a new tab)
        </a>
    </govuk-phase-banner>

    @{
        if (ViewData["Breadcrumbs"] is List<Breadcrumb> breadcrumbs && breadcrumbs.Any())
        {
            <partial name="Breadcrumb/_Breadcrumbs" model="breadcrumbs"/>
        }
    }


    @if (isAuthenticated)
    {
        var showConnectBanner = await FeatureManager.IsEnabledAsync(FeatureFlagConstants.FeedbackBanner);

        if (showConnectBanner)
        {
            <partial
                name="_ConnectBanner"
                view-data='new ViewDataDictionary(ViewData)
                {
                    ["FeedbackUrl"] = feedbackUrl
                }'/>
        }
    }
}

@section BodyEnd 
{
    @Html.GovUkFrontendScriptImports()

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/feedback.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}

@section GovUkFooter 
{
    @if (isAuthenticated)
    {
        <partial name="Feedback/_Feedback"/>
    }

    <govuk-footer>
        <govuk-footer-meta>
            <govuk-footer-meta-items>
                <govuk-footer-meta-item href="@RouteConstants.Cookies">
                    Cookies
                </govuk-footer-meta-item>
                <govuk-footer-meta-item href="@RouteConstants.PrivacyPolicy">
                    Privacy notice
                </govuk-footer-meta-item>
                <govuk-footer-meta-item href="@RouteConstants.AccessibilityStatement">
                    Accessibility statement
                </govuk-footer-meta-item>
                <govuk-footer-meta-item href="@RouteConstants.ContactUs">
                    Contact us
                </govuk-footer-meta-item>
                <govuk-footer-meta-item href="@RouteConstants.About">
                    About
                </govuk-footer-meta-item>
            </govuk-footer-meta-items>
        </govuk-footer-meta>

        <govuk-footer-content-licence>
            All content is available under the
            <a class="govuk-footer__link"
               href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"
               rel="license">
                Open Government Licence v3.0
            </a>,
            except where otherwise stated
        </govuk-footer-content-licence>

        <govuk-footer-copyright/>
    </govuk-footer>
}

@await RenderSectionAsync("BeforeContent", false)

@await RenderSectionAsync("Header", false)

@if (IsSectionDefined("SuccessBanner"))
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await RenderSectionAsync("SuccessBanner", required: false)
        </div>
    </div>
}

<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                @if (IsSectionDefined("PageHeading"))
                {
                    @if (isAuthenticated)
                    {
                        <p class="govuk-caption govuk-caption-l">@organisationName</p>
                    }

                    @await RenderSectionAsync("PageHeading", required: false)
                }

                @RenderBody()
            </div>
            @if (showRightHandSide)
            {
                <div class="govuk-grid-column-one-third govuk-!-margin-top-0">
                    <partial name="Images/DividerLine"></partial>

                    @if (IsSectionDefined("RightSide"))
                    {
                        <div class="govuk-!-margin-bottom-6">
                            @await RenderSectionAsync("RightSide")
                        </div>
                    }

                    <partial name="_ContactUs"/>
                </div>
            }
        </div>
    </main>
</div>

@await RenderSectionAsync("GovUkFooter", required: false)
