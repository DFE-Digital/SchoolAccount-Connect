@using SchoolAccount.Web.Manage.Extensions
@model string

@{
    var field = ViewData.GetFieldMetadata();
}

<govuk-input for="@Model" name="@field.FieldName">
    
    <govuk-input-label is-page-heading="false" class="govuk-label--m">
        @field.Label
        @if (!field.IsRequired)
        {
            <span class="govuk-hint">(optional)</span>
        }
    </govuk-input-label>
    
    @if (field.HasDescription)
    {
        <govuk-input-hint>
            @field.Description
        </govuk-input-hint>
    }
    
    @if (field.HasValidError)
    {
        <govuk-input-error-message>
            @field.ErrorMessage
        </govuk-input-error-message>
    }

</govuk-input>