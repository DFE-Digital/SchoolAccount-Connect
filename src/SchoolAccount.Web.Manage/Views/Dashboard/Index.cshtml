@model SchoolAccount.Application.Features.Dashboard.Queries.GetDashboard.DashboardLists

@{
    ViewData["Title"] = "Home - Manage";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Manage your DfE Connect data
        </h1>
    </div>
    <div class="govuk-grid-column-one-third">
        <div class="govuk-button-group" style="justify-content: flex-end;">
            <govuk-button-link asp-controller="Page" asp-action="Create">
                Add a page
            </govuk-button-link>
            <govuk-button-link asp-controller="Service" asp-action="Create">
                Add a service
            </govuk-button-link>
        </div>
    </div>
</div>

<govuk-tabs>
    <govuk-tabs-item id="recently-edited-pages-tab" label="Recently edited Pages">
        <h2 class="govuk-heading-s">
            Recently edited pages
        </h2>
        @foreach (var entry in Model.PageEdits)
        {
            <partial name="_BaseListItem" model="entry"/>
        }
    </govuk-tabs-item>

    <govuk-tabs-item id="recently-published-tab" label="Recently published pages">
        <h2 class="govuk-heading-s">
            Recently published pages
        </h2>

        @foreach (var entry in Model.PagePublished)
        {
            <partial name="_BaseListItem" model="entry"/>
        }
    </govuk-tabs-item>
</govuk-tabs>
